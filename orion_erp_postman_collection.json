          "name": "Get Customer Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", ":id"],
              "variable": [{ "key": "id", "value": "CUSTOMER_UUID_HERE" }]
